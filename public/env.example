# Copy this file to .env for local work. NEVER commit .env.
# On Vercel, set these in Project Settings > Environment Variables instead.

# REQUIRED on Vercel: Postgres connection string (Neon, Supabase, etc.).
# Leave empty locally to use the built-in LOCAL DEMO database (stored in .data/, not for production).
DATABASE_URL=

# REQUIRED on Vercel: a long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: public URL of the site (used in password reset links). Example: https://workspark.vercel.app
APP_URL=

# Optional: real password-reset emails through Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=WorkSpark <no-reply@your-domain.com>

# Only for scripts/create-admin.js (use a strong password, 12+ characters). Do not commit.
ADMIN_EMAIL=
ADMIN_PASSWORD=
